@model List<StudentAcedamic.Models.Student>

<h2>Student List</h2>
<br />

<a asp-action="Create" class="btn btn-primary">
    Add Student
</a>

<a asp-action="Report" class="btn btn-primary">
    View Report
</a>

<br />
<br />

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>RollNo</th>
            <th>Course</th>
        </tr>
    </thead>

    <tbody>
        @foreach(var s in Model)
        {
            <tr>
                <td>@s.Id</td>
                <td>@s.Name</td>
                <td>@s.RollNo</td>
                <td>@s.Course</td>
            </tr>
        }
    </tbody>
</table>

