@model List<StudentAcedamic.Models.Student>
 <h2 class="mb-4">Student Marks Report </h2>

 <!-- Pass Fail count-->

 <div style="display:flex;gap:20px;margin-bottom:30px;">
     <div style="
        width:220px;
        padding:20px;
        background:#d4edda;
        border:1px solid #c3e6cb;
        border-radius:8px;
       ">
         <h4>Pass Students</h4>

         <h2>
             @Model.Count(x=>x.Mark!=null &&
                              x.Mark.Result=="Pass")
         </h2>

     </div>

    <div style="
        width:220px;
        padding:20px;
        background:#f8d7da;
        border:1px solid #f5c6cb;
        border-radius:8px;
        ">
        <h4>Fail Students</h4>

        <h2>
            @Model.Count(x => x.Mark != null &&
                             x.Mark.Result == "Fail")
        </h2>

    </div>

 </div>

 <!-- search and filter  -->

 <form asp-action="Report" method="get" style="margin-bottom:20px">
     
     <div style="display:flex;gap:10px;align-items:center;">
        
         <!--search-->
        
         <input type="text"
             name="search"
             value="@Context.Request.Query["search"]"
             placeholder="Search Name or Roll No"
             class="form-control"
             style="width:250px;" />

        <!--Resul Filter -->
        <select name="resultFilter"
            class="form-check-control"
            style="width:150px;">
            
            <option value="All">
                All
            </option>

            <option value="Pass">
                Pass
            </option>

            <option value="Fail">
                Fail
            </option>
        </select>
        <button type="submit" class="btn btn-primary">
            Search
        </button>

        <a asp-action="Report"
        class="btn btn-secondary">
         clear
        </a>


     </div>
 </form>
 <!--Report table -->
 <table class="table table-bordered table-striped">
     <thead>
         <tr>
             <th>Student Name</th>
             <th>Roll No</th>
            <th>Course</th>
            <th>Maths</th>
            <th>Science</th>
            <th>English</th>
            <th>Computer</th>
            <th>Total</th>
            <th>Percentage</th>
            <th>Result</th>
         </tr>
     </thead>

     <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.Name</td>
                <td>@s.RollNo</td>
                <td>@s.Course</td>
                <td>@s.Mark.Maths</td>
                <td>@s.Mark.Science</td>
                <td>@s.Mark.English</td>
                <td>@s.Mark.Computer</td>
                <td>@s.Mark.Total</td>
                <td>@s.Mark.Percentage.ToString("F2")%</td>
                <td>
                    @if (s.Mark.Result == "Pass")
                    {
                        <span class="text-success">
                            Pass
                        </span>
                    }
                    else
                    {
                        <span class="text-danger">
                            Fail
                        </span>
                    }
                </td>
            </tr>
        }
     </tbody>
        
    </table>

    <br />
    <button onclick="window.print()" class="btn btn-dark">
        Print Report
    </button>