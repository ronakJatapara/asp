@model IEnumerable<WebApplication3.Models.Book>

<a href="/Books/BooksCreate">books</a>


<table>

    <tr style="background-color: #f2f2f2;">
        <th>Book ID</th>
        <th>Book Name</th>
        <th>Price</th>
        <th>Author Name</th>
        <th>Country</th>
    </tr>

   @foreach(var item in Model){
<tr>
    <td>@item.Id</td>
    <td>@item.Name</td>
    <td>@item.Price</td>
    <td>@(item.Author != null ? item.Author.Name : "N/A")</td>
    <td>@(item.Author != null ? item.Author.Country : "N/A")</td>
    <td>
        <a href="/Books/Edit/@item.Id">Edit</a>
        <a href="/Books/Delete/@item.Id">Delete</a>

    </td>
</tr>
    }
</table>